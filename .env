# LLM Configuration
# Set LLM_PROVIDER to 'openai' or 'anthropic'
LLM_PROVIDER=anthropic

# OpenAI API Key (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=openai_api_key_here

# Anthropic API Key (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=anthropic_api_key_here

# LLM_API_KEY is used by the app - set it based on your provider
LLM_API_KEY=anthropic_api_key_here
# Server Configuration  
PORT=3000
BACKEND_PORT=5055
BACKEND_URL=http://localhost:5055
FLASK_DEBUG=False

# Local MySQL dev database. These match docker-compose.yml defaults.
FLASK_SECRET_KEY=local-dev-change-me
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=outsmartai
MYSQL_PASSWORD=outsmartai_dev_password
MYSQL_DATABASE=outsmartai
MYSQL_ROOT_PASSWORD=outsmartai_dev_root
DB_AUTO_INIT=True
DB_AUTO_SEED=True
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234
ADMIN_DISPLAY_NAME=Admin User
ADMIN_EMAIL=
