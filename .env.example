# LLM Configuration
# Choose your LLM provider: 'openai', 'anthropic', 'google', or 'mock'
LLM_PROVIDER=mock

# API Keys (add your actual key for your chosen provider)
LLM_API_KEY=your_api_key_here

# Server Configuration
PORT=3000
BACKEND_PORT=5055
BACKEND_URL=http://localhost:5055

# Flask Configuration
FLASK_DEBUG=False
FLASK_SECRET_KEY=change-me-in-development
ENABLE_FORMALGEO=False

# MySQL Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=outsmartai
MYSQL_PASSWORD=outsmartai_dev_password
MYSQL_DATABASE=outsmartai
MYSQL_ROOT_PASSWORD=outsmartai_dev_root
DB_AUTO_INIT=True
DB_AUTO_SEED=True
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234
ADMIN_DISPLAY_NAME="Admin User"
ADMIN_EMAIL=
